{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/figure/:path*", "destination": "/figure" },
    { "source": "/embed/:path*", "destination": "/embed" },
    { "source": "/who/:path*", "destination": "/who" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
